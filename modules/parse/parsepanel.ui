      <property name="topMargin"><number>10</number></property>
      <property name="rightMargin"><number>12</number></property>
      <property name="bottomMargin"><number>10</number></property>
      <item><widget class="QLabel" name="protoLabel"><property name="styleSheet"><string>font-size:13px;font-weight:600;color:#12263f;</string></property><property name="text"><string>协议:</string></property></widget></item>
      <item><widget class="QComboBox" name="protocolCombo"><property name="minimumSize"><size><width>240</width><height>32</height></size></property><property name="styleSheet"><string>font-size:12px;</string></property></widget></item>
      <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
      <!-- 下拉项由代码动态生成（按类分组） -->
     </layout>
    </widget>
   </item>

   <!-- ═══ 解析结果输出区 ═══ -->
   <item>
    <widget class="QTextEdit" name="outputTextEdit">
