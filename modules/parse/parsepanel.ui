     <item><widget class="QLabel" name="titleLabel"><property name="styleSheet"><string>font-size:16px;font-weight:700;color:#12263f;</string></property><property name="text"><string>数据解析</string></property></widget></item>
     <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
    </layout>
   </item>

   <!-- ═══ 文件加载行 ═══ -->
