      <property name="rightMargin"><number>12</number></property>
      <property name="bottomMargin"><number>10</number></property>
      <item><widget class="QPushButton" name="loadFileButton"><property name="minimumSize"><size><width>100</width><height>36</height></size></property><property name="text"><string>加载文件</string></property><property name="styleSheet"><string>QPushButton{background:#17324d;color:white;border-radius:4px;font-size:13px;font-weight:600;padding:0 16px;}QPushButton:hover{background:#1e426b;}</string></property></widget></item>
      <item><widget class="QCheckBox" name="crcCheckBox"><property name="text"><string>CRC校验</string></property><property name="styleSheet"><string>font-size:13px;font-weight:600;color:#42556d;</string></property></widget></item>
      <item><widget class="QLabel" name="filePathLabel"><property name="styleSheet"><string>font-size:13px;color:#617487;</string></property><property name="text"><string>未加载文件</string></property></widget></item>
      <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
      <item><widget class="QLabel" name="fileInfoLabel"><property name="styleSheet"><string>font-size:13px;color:#12263f;</string></property><property name="text"><string/></property></widget></item>
     </layout>
    </widget>
   </item>

   <!-- ═══ 协议按钮行 ═══ -->
   <item>
    <widget class="QFrame" name="filterFrame">
