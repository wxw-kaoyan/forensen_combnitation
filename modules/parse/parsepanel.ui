   </item>

   <!-- ═══ 底部操作行 ═══ -->
   <item>
    <layout class="QHBoxLayout" name="actionLayout">
     <item><widget class="QPushButton" name="exportButton"><property name="minimumSize"><size><width>100</width><height>36</height></size></property><property name="text"><string>导出CSV</string></property><property name="styleSheet"><string>QPushButton{background:#17324d;color:white;border-radius:4px;font-size:13px;font-weight:600;padding:0 16px;}QPushButton:hover{background:#1e426b;}</string></property></widget></item>
     <item><widget class="QPushButton" name="newCodeButton"><property name="minimumSize"><size><width>100</width><height>36</height></size></property><property name="text"><string>New Code</string></property><property name="styleSheet"><string>QPushButton{background:#2a5a8c;color:white;border-radius:4px;font-size:13px;font-weight:600;padding:0 16px;}QPushButton:hover{background:#3169a3;}</string></property></widget></item>
     <item><widget class="QPushButton" name="downsampleButton"><property name="minimumSize"><size><width>100</width><height>36</height></size></property><property name="text"><string>降采样</string></property><property name="styleSheet"><string>QPushButton{background:#2a5a8c;color:white;border-radius:4px;font-size:13px;font-weight:600;padding:0 16px;}QPushButton:hover{background:#3169a3;}</string></property></widget></item>
